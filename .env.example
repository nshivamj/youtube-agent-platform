# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Required — get your key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# GitHub MCP server — get a token at https://github.com/settings/tokens
# Required scopes: repo (read), issues (write)
GITHUB_TOKEN=your-github-personal-access-token-here

# Optional overrides
APP_NAME=adk_platform
LOG_LEVEL=INFO

# --- Model config: pick ONE block ---

# Google Gemini (default)
MODEL=gemini-2.0-flash
# GOOGLE_API_KEY is required when using Gemini

# Ollama (local) — comment out Gemini block above and uncomment below
# MODEL=ollama/llama3.2
# OLLAMA_BASE_URL=http://localhost:11434
# GOOGLE_API_KEY is not needed for Ollama

# Per-agent overrides (any provider)
# MODEL_COORDINATOR_AGENT=ollama/llama3.2
# MODEL_GITLAB_AGENT=gemini-2.0-flash
